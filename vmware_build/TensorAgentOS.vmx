.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "21"
displayName = "TensorAgent OS"
guestOS = "arm-ubuntu-64"

# CPU and Memory
numvcpus = "4"
memsize = "8192"

# EFI Firmware
firmware = "efi"

# PCIe Root Ports — required on ARM64 for device slots
pciBridge0.present = "TRUE"
pciBridge0.virtualDev = "pcieRootPort"
pciBridge0.functions = "8"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"

# NVMe Storage (ARM64 — no SCSI/lsilogic)
nvme0.present = "TRUE"
nvme0:0.fileName = "ainux.vmdk"
nvme0:0.present = "TRUE"
nvme0.pciSlotNumber = "192"

# Network — vmxnet3 is the only supported NIC on ARM64 Fusion
ethernet0.present = "TRUE"
ethernet0.virtualDev = "vmxnet3"
ethernet0.connectionType = "nat"
ethernet0.addressType = "generated"
ethernet0.startConnected = "TRUE"
ethernet0.pciSlotNumber = "160"

# USB
usb.present = "TRUE"
usb_xhci.present = "TRUE"
usb_xhci.pciSlotNumber = "224"

# No sound (not needed for server OS, avoids es1371 errors)
sound.present = "FALSE"

# Display
svga.graphicsMemoryKB = "262144"

# Misc
tools.syncTime = "TRUE"
powerType.suspend = "soft"
virtualHW.productCompatibility = "hosted"
vmxstats.filename = "TensorAgentOS.scoreboard"
numa.autosize.cookie = "40012"
numa.autosize.vcpu.maxPerVirtualNode = "4"
uuid.bios = "56 4d fc bc 67 ce fe fd-d3 17 d3 c2 8a c8 54 56"
uuid.location = "56 4d fc bc 67 ce fe fd-d3 17 d3 c2 8a c8 54 56"
pciBridge0.pciSlotNumber = "21"
pciBridge4.pciSlotNumber = "22"
pciBridge5.pciSlotNumber = "23"
pciBridge6.pciSlotNumber = "24"
pciBridge7.pciSlotNumber = "25"
usb.pciSlotNumber = "16"
nvme0:0.redo = ""
svga.vramSize = "268435456"
vmotion.checkpointFBSize = "4194304"
vmotion.checkpointSVGAPrimarySize = "268435456"
vmotion.svga.mobMaxSize = "268435456"
vmotion.svga.graphicsMemoryKB = "262144"
ethernet0.generatedAddress = "00:0c:29:c8:54:56"
ethernet0.generatedAddressOffset = "0"
nvme0.subnqnUUID = "52 24 83 8c 0e 15 0f 69-f4 d8 8d 8c dc bb c6 74"
monitor.phys_bits_used = "36"
cleanShutdown = "FALSE"
softPowerOff = "FALSE"
usb_xhci:6.speed = "2"
usb_xhci:6.present = "TRUE"
usb_xhci:6.deviceType = "hub"
usb_xhci:6.port = "6"
usb_xhci:6.parent = "-1"
usb_xhci:7.speed = "4"
usb_xhci:7.present = "TRUE"
usb_xhci:7.deviceType = "hub"
usb_xhci:7.port = "7"
usb_xhci:7.parent = "-1"
svga.guestBackedPrimaryAware = "TRUE"
tools.capability.verifiedSamlToken = "TRUE"
guestInfo.detailed.data = "architecture='Arm' bitness='64' distroAddlVersion='24.04.4 LTS (Noble Numbat)' distroName='Ubuntu' distroVersion='24.04' familyName='Linux' kernelVersion='6.8.0-117-generic' prettyName='Ubuntu 24.04.4 LTS'"
extendedConfigFile = "TensorAgentOS.vmxf"
usb_xhci:4.present = "TRUE"
usb_xhci:4.deviceType = "hid"
usb_xhci:4.port = "4"
usb_xhci:4.parent = "-1"
