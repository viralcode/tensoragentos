[Unit]
Description=TensorAgent OS First Boot Setup Wizard
Documentation=https://github.com/viralcode/openwhale
After=multi-user.target
ConditionPathExists=!/etc/ainux/.first-boot-complete

[Service]
Type=oneshot
ExecStart=/opt/ainux/first-boot-setup.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
